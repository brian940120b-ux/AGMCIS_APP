APP_ENV=dev

# ---------------- BingX 合約 ----------------
# 只看行情/訊號不需要金鑰;要下單/查詢部位、餘額才需要填
BINGX_API_KEY=
BINGX_API_SECRET=

# ---------------- 監控清單 ----------------
WATCHLIST_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT

# ---------------- 資料層行為 ----------------
EXCHANGE_TIMEOUT_MS=8000
EXCHANGE_MAX_RETRIES=3
