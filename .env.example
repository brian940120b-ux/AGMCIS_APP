APP_ENV=dev

# ---------------- 資料庫(必填) ----------------
# 密碼不再寫在 db.py 裡。舊版曾把密碼提交進 git,部署時請設定這裡並輪替該密碼。
DB_NAME=agmcis_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---------------- BingX 合約 ----------------
# 只看行情/訊號不需要金鑰;要下單/查詢部位、餘額才需要填
BINGX_API_KEY=
BINGX_API_SECRET=

# ---------------- 監控清單 ----------------
WATCHLIST_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT

# ---------------- 資料層行為 ----------------
EXCHANGE_TIMEOUT_MS=8000
EXCHANGE_MAX_RETRIES=3
EXCHANGE_RETRY_BACKOFF_SECONDS=0.8

# ---------------- Telegram ----------------
# 正式名稱是 TELEGRAM_*。舊名 BOT_TOKEN / CHAT_ID 仍可用(向下相容),但建議改用新名。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 允許下指令的 chat id,逗號分隔。留空代表只接受 TELEGRAM_CHAT_ID。
# 未列在名單內的來源,指令會被拒絕並記錄 —— 不設定白名單就沒有人能控制系統。
TELEGRAM_ALLOWED_CHAT_IDS=
DISABLE_TELEGRAM_PUSH=false

# ---------------- Web / API 存取 ----------------
# Dashboard 與所有 /api/* 端點共用這把金鑰。務必改掉,不要沿用範例值。
DASHBOARD_KEY=
# 設為 true 時 cookie 只在 HTTPS 下傳送(已掛 TLS 的正式環境請開啟)
SESSION_COOKIE_SECURE=false

# ---------------- Paper Trading ----------------
PAPER_START_BALANCE=10000

# ---------------- 風控(全部可調,不再硬編碼) ----------------
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_USDT=300
MAX_DRAWDOWN_PCT=15
MAX_EXPOSURE_PCT=80
MAX_OPEN_POSITIONS=5
MAX_LEVERAGE=5
MAX_CONSECUTIVE_LOSSES=4
MAX_TRADES_PER_DAY=10
MIN_PROFIT_FACTOR=0.8
MAX_TOTAL_OPEN_LOSS_USDT=-300
