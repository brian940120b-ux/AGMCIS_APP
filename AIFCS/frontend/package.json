{
  "name": "aifcs-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AIFCS Command Center \u2014 dashboard for the fictional multi-agent flight simulation platform.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test:e2e": "node e2e/smoke.mjs",
    "test:e2e:sim": "node e2e/simulation.mjs",
    "test:e2e:3d": "node e2e/view3d.mjs",
    "test:e2e:replay": "node e2e/replay.mjs",
    "test:e2e:editor": "node e2e/editor.mjs",
    "test:e2e:coordination": "node e2e/coordination.mjs",
    "test:e2e:analytics": "node e2e/analytics.mjs",
    "test:e2e:training": "node e2e/training.mjs",
    "test:e2e:models": "node e2e/models.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "lucide-react": "^0.468.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.186.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5"
  }
}
