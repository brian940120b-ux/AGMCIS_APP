data/jsbsim/*
!data/**/.gitkeep
models/*
!models/.gitkeep
*.db
*.sqlite3
# WAL journalling writes two sidecar files next to the database.
*.db-shm
*.db-wal
*.sqlite3-shm
*.sqlite3-wal
*.jsonl
*.log

# Environment
.env
.env.local

# OS / editor
.DS_Store
Thumbs.db
